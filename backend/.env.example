# Copy to backend/.env and fill in. Never commit the real .env.
MONGODB_URI=mongodb://localhost:27017
MONGO_DB_NAME=interview_db
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRONTEND_URL=http://localhost:5173

# Google Gemini (questions, evaluation, reports)
GEMINI_API_KEY=
# An empty value would override the code's default, so keep these filled in.
# Run `python check_services.py` to see which models your key can use.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite,gemini-3.8-flash

# Cartesia (text-to-speech voice of the interviewer)
CARTESIA_API_KEY=

# LiveKit (real-time audio/video rooms)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Proctoring
ANALYSIS_FRAME_RATE=1
FACE_DETECTION_CONFIDENCE=0.5
EYE_CONTACT_THRESHOLD=0.5

# ImageKit (resume / media uploads)
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=

# Email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
